# .easignore - CONSERVATIVE version (only excludes 100% safe items)
# This version is extremely safe and only excludes files that are 
# GUARANTEED to be regenerated during the build process

# Node modules - Always reinstalled from package.json
node_modules/

# iOS Pods - Always reinstalled from Podfile
ios/Pods/

# Expo cache - Always regenerated
.expo/

# Build output directories - Always regenerated
android/app/build/
android/build/
ios/build/

# Log files - Never needed for builds
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# That's it! Only the absolute safest exclusions.
