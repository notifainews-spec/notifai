# ============================================
# EXAMPLE ENVIRONMENT VARIABLES
# ============================================
# This is a template file showing what environment variables are needed.
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real values to GitHub!

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ============================================
# SITE CONFIGURATION
# ============================================
SITE_NAME=NotifAi News
PORT=8080

# ============================================
# OPENAI MODEL SETTINGS
# ============================================
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_DEBATE_MODEL=gpt-4o-mini
MAX_PER_CATEGORY=6
OPENAI_TIMEOUT_MS=120000
DISABLE_DEBATE=false
SAFE_MODE_SUMMARY=false

# ============================================
# FIREBASE ADMIN SDK (Required for authentication)
# ============================================
# Get these from your Firebase Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================
# SECURITY SETTINGS
# ============================================
# Set to true to allow legacy authentication (for backward compatibility)
# Set to false once all users have updated to the new app version
ALLOW_LEGACY_AUTH=true

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://www.notifai.news,https://notifai.news,http://localhost:3000

# ============================================
# GOOGLE TRANSLATE API (Optional - for UI translations)
# ============================================
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_TRANSLATE_API_KEY=YOUR_GOOGLE_TRANSLATE_API_KEY_HERE

# ============================================
# INGESTION SETTINGS (Optional - defaults are fine)
# ============================================
INGEST_MAX_PER_CAT=10
INGEST_PER_FEED=5
FETCH_CONCURRENCY=3
INGEST_MINUTES=60
